<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="car_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="libignition-gazebo-physics-system.so" name="ignition::gazebo::systems::Physics" />
    <plugin filename="libignition-gazebo-user-commands-system.so" name="ignition::gazebo::systems::UserCommands" />
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so" name="ignition::gazebo::systems::SceneBroadcaster" />
    <!-- センサ用プラグインの追加 -->
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 光源 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 追従対象の赤いボール（初期位置: ロボットの前方1.5m, 少し左） -->
    <model name="target_ball">
      <pose>1.5 0.5 0.1 0 0 0</pose>
      <link name="ball_link">
        <collision name="collision">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ロボット本体 -->
    <model name="diff_drive_robot">
      <pose>0 0 0.05 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.01</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.01</iyy><iyz>0</iyz><izz>0.01</izz></inertia>
        </inertial>
        <visual name="base_visual">
          <geometry><box><size>0.3 0.15 0.05</size></box></geometry>
          <material><diffuse>0 0 1 1</diffuse></material>
        </visual>
        <collision name="base_collision">
          <geometry><box><size>0.3 0.15 0.05</size></box></geometry>
        </collision>

        <!-- カメラセンサの追加（ロボット前方に配置） -->
        <sensor name="front_camera" type="camera">
          <pose>0.15 0 0.05 0 0 0</pose>
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <topic>/camera</topic>
        </sensor>
      </link>

      <!-- 左車輪 -->
      <link name="wheel_left_link">
        <pose>0.0 0.095 0.0 -1.5707 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="wheel_left_visual">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="wheel_left_collision">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="wheel_left_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_left_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- 右車輪 -->
      <link name="wheel_right_link">
        <pose>0.0 -0.095 0.0 -1.5707 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <visual name="wheel_right_visual">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
          <material><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <collision name="wheel_right_collision">
          <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        </collision>
      </link>
      <joint name="wheel_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_right_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- キャスター -->
      <link name="caster_front_link">
        <pose>0.12 0 -0.018 0 0 0</pose>
        <collision name="collision"><geometry><sphere><radius>0.015</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.015</radius></sphere></geometry><material><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
      <joint name="caster_front_joint" type="ball">
        <parent>base_link</parent>
        <child>caster_front_link</child>
      </joint>

      <link name="caster_back_link">
        <pose>-0.12 0 -0.018 0 0 0</pose>
        <collision name="collision"><geometry><sphere><radius>0.015</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.015</radius></sphere></geometry><material><diffuse>0 1 0 1</diffuse></material></visual>
      </link>
      <joint name="caster_back_joint" type="ball">
        <parent>base_link</parent>
        <child>caster_back_link</child>
      </joint>

      <!-- 差動駆動プラグイン -->
      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.19</wheel_separation>
        <wheel_radius>0.033</wheel_radius>
        <topic>/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>
